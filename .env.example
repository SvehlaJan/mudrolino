# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Enables the staged avatar proof of concept on Home and /avatar-preview.
# Off by default unless explicitly set to "true".
VITE_AVATAR_POC_ENABLED="false"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Web3Forms access key for the parent feedback form.
# Get a free key at https://web3forms.com — 250 submissions/month on the free plan.
VITE_WEB3FORMS_KEY=your_key_here

# Private Cloudflare R2 bucket holding the avatar 3D files (npm run assets:push / assets:pull).
# Create an R2 API token with Object Read & Write on this bucket only.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=teo-learn-avatar-assets
