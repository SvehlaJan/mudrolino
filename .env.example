# Enables the staged avatar proof of concept on Home and /avatar-preview.
# Off by default unless explicitly set to "true".
VITE_AVATAR_POC_ENABLED="false"

# Web3Forms access key for the parent feedback form.
# Get a free key at https://web3forms.com — 250 submissions/month on the free plan.
VITE_WEB3FORMS_KEY=your_key_here

# Sentry error reporting (production builds only). Create the organization in the
# EU (Frankfurt) data region and copy the project's DSN. Without it nothing is sent.
VITE_SENTRY_DSN=
# Optional: upload source maps during the Vercel production build so stack traces
# are readable. Use an organization auth token; maps are deleted after upload.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# The upload tool talks to the US server unless told otherwise; EU organizations use this.
SENTRY_URL=https://de.sentry.io/

# Private Cloudflare R2 bucket holding the avatar 3D files (npm run assets:push / assets:pull).
# Create an R2 API token with Object Read & Write on this bucket only.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET=teo-learn-avatar-assets
